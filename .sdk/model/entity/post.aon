# Entity: post

main: kit: entity: post: {

  alias: field: {}

  fields: [
    {
      name: "actual_preview_height"
      req: false
      short: "Actual height of the preview image"
      type: "`$INTEGER`"
    }
    {
      name: "actual_preview_width"
      req: false
      short: "Actual width of the preview image"
      type: "`$INTEGER`"
    }
    {
      name: "author"
      req: false
      short: "Username of the post creator"
      type: "`$STRING`"
    }
    {
      name: "change"
      req: false
      short: "Change number/version"
      type: "`$INTEGER`"
    }
    {
      name: "created_at"
      req: false
      short: "Unix timestamp of when the post was created"
      type: "`$INTEGER`"
    }
    {
      name: "creator_id"
      req: false
      short: "User ID of the post creator"
      type: "`$INTEGER`"
    }
    {
      name: "file_size"
      req: false
      short: "File size in bytes"
      type: "`$INTEGER`"
    }
    {
      name: "file_url"
      req: false
      short: "URL to the full-size image"
      type: "`$STRING`"
    }
    {
      name: "flag_detail"
      req: false
      short: "Flag details if the post is flagged"
      type: "`$OBJECT`"
    }
    {
      name: "frames"
      req: false
      short: "Array of frames"
      type: "`$ARRAY`"
    }
    {
      name: "frames_pending"
      req: false
      short: "Array of pending frames"
      type: "`$ARRAY`"
    }
    {
      name: "frames_pending_string"
      req: false
      short: "Pending frames information"
      type: "`$STRING`"
    }
    {
      name: "frames_string"
      req: false
      short: "Frames information"
      type: "`$STRING`"
    }
    {
      name: "has_children"
      req: false
      short: "Whether the post has child posts"
      type: "`$BOOLEAN`"
    }
    {
      name: "height"
      req: false
      short: "Original image height"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Post ID"
      type: "`$INTEGER`"
    }
    {
      name: "is_held"
      req: false
      short: "Whether the post is held"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_shown_in_index"
      req: false
      short: "Whether the post is shown in the index"
      type: "`$BOOLEAN`"
    }
    {
      name: "jpeg_file_size"
      req: false
      short: "File size of the JPEG version in bytes"
      type: "`$INTEGER`"
    }
    {
      name: "jpeg_height"
      req: false
      short: "Height of the JPEG version"
      type: "`$INTEGER`"
    }
    {
      name: "jpeg_url"
      req: false
      short: "URL to the JPEG version"
      type: "`$STRING`"
    }
    {
      name: "jpeg_width"
      req: false
      short: "Width of the JPEG version"
      type: "`$INTEGER`"
    }
    {
      name: "md5"
      req: false
      short: "MD5 hash of the image file"
      type: "`$STRING`"
    }
    {
      name: "parent_id"
      req: false
      short: "ID of the parent post"
      type: "`$INTEGER`"
    }
    {
      name: "pool_ids"
      req: false
      short: "Array of pool IDs this post belongs to (included when include_pools=1)"
      type: "`$ARRAY`"
    }
    {
      name: "preview_height"
      req: false
      short: "Height of the preview image"
      type: "`$INTEGER`"
    }
    {
      name: "preview_url"
      req: false
      short: "URL to the preview/thumbnail image"
      type: "`$STRING`"
    }
    {
      name: "preview_width"
      req: false
      short: "Width of the preview image"
      type: "`$INTEGER`"
    }
    {
      name: "rating"
      req: false
      short: "Post rating (s=safe, q=questionable, e=explicit)"
      type: "`$STRING`"
    }
    {
      name: "sample_file_size"
      req: false
      short: "File size of the sample image in bytes"
      type: "`$INTEGER`"
    }
    {
      name: "sample_height"
      req: false
      short: "Height of the sample image"
      type: "`$INTEGER`"
    }
    {
      name: "sample_url"
      req: false
      short: "URL to the sample-size image"
      type: "`$STRING`"
    }
    {
      name: "sample_width"
      req: false
      short: "Width of the sample image"
      type: "`$INTEGER`"
    }
    {
      name: "score"
      req: false
      short: "Post score"
      type: "`$INTEGER`"
    }
    {
      name: "source"
      req: false
      short: "Source URL of the image"
      type: "`$STRING`"
    }
    {
      name: "status"
      req: false
      short: "Post status"
      type: "`$STRING`"
    }
    {
      name: "tags"
      req: false
      short: "Space-separated list of tags associated with the post"
      type: "`$STRING`"
    }
    {
      name: "votes"
      req: false
      short: "Vote information (included when include_votes=1)"
      type: "`$OBJECT`"
    }
    {
      name: "width"
      req: false
      short: "Original image width"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "post"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "api_version"
                orig: "api_version"
                reqd: true
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "filter"
                orig: "filter"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "include_pool"
                orig: "include_pool"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "include_tag"
                orig: "include_tag"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "include_vote"
                orig: "include_vote"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 20
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "holds:false"
                kind: "query"
                name: "tag"
                orig: "tag"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/post.json"
          parts: [
            "post.json"
          ]
          select: {
            exist: [
              "api_version"
              "filter"
              "include_pool"
              "include_tag"
              "include_vote"
              "limit"
              "tag"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
